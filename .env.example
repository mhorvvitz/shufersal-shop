# Copy this file to .env and fill in your values. .env is gitignored.

# ─── Your Shufersal online account ───────────────────────────────────────────
SHUFERSAL_USERNAME=your-username
SHUFERSAL_PASSWORD=your-password

# ─── Which browser the bot drives ────────────────────────────────────────────
# local       = launch Chrome on this machine (default; needs a desktop/laptop)
# browserless = connect to a Browserless instance (hosted or self-hosted)
# browserbase = create a Browserbase session and connect to it
# cdp         = connect to any Chrome DevTools Protocol websocket you supply
#
# Verify whichever you pick with:  npm run check-browser
BROWSER_PROVIDER=local

# ─── BROWSER_PROVIDER=local ──────────────────────────────────────────────────
# Absolute path to a local Chrome executable.
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:   /usr/bin/google-chrome
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Extra Chrome flags, space- or comma-separated. Containers and WSL usually need --no-sandbox.
# CHROME_ARGS=--no-sandbox

# ─── BROWSER_PROVIDER=browserless ────────────────────────────────────────────
# BROWSERLESS_TOKEN=your-browserless-token
# Defaults to wss://production-ams.browserless.io — Browserless runs in SFO, LON and AMS,
# and Amsterdam is the closest to Israel. Override to pick another region, to pin an
# explicit browser path (…browserless.io/chromium), or when self-hosting (ws://localhost:3000).
# Shufersal geo-blocks Browserless's datacenter IPs (foreign IPs get a "selected countries
# only" page with no login form), so hosted plans need the residential proxy pinned to
# Israel. Extra query params are fine — the token is appended correctly either way.
# Note: residential proxy traffic is billed per MB on top of session units.
# BROWSERLESS_URL=wss://production-ams.browserless.io?proxy=residential&proxyCountry=il

# ─── BROWSER_PROVIDER=browserbase ────────────────────────────────────────────
# BROWSERBASE_API_KEY=your-browserbase-api-key
# BROWSERBASE_PROJECT_ID=your-browserbase-project-id
# Route the session through an exit IP in this country. Shufersal is an Israeli
# retailer, so IL is the safe choice if you hit blocks or geo-redirects.
# BROWSERBASE_PROXY_COUNTRY=IL

# ─── BROWSER_PROVIDER=cdp ────────────────────────────────────────────────────
# Any Chrome DevTools Protocol websocket — your own container, a VPS, another
# vendor, or `chrome --remote-debugging-port=9222`.
# BROWSER_WS_ENDPOINT=ws://127.0.0.1:9222/devtools/browser/<id>
