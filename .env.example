# Copy this file to .env and fill in your values. .env is gitignored.

# Your Shufersal online account credentials.
SHUFERSAL_USERNAME=your-username
SHUFERSAL_PASSWORD=your-password

# Where to get a Chrome instance from. Set ONE of the two:

# Option A — local Chrome (default). Absolute path to a local Chrome executable.
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:   /usr/bin/google-chrome
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Option B — hosted/remote headless Chrome. If set, this takes precedence over
# CHROME_PATH: the bot connects to an already-running Chrome instead of launching
# a local one (e.g. a self-hosted browserless/chrome-headless-shell container, or a
# managed browser-as-a-service provider). Most providers fold their auth token into
# this URL (e.g. wss://chrome.browserless.io?token=YOUR_API_KEY) — paste the
# connection URL they give you as-is; treat it as a secret like the password above.
# A hosted deployment (Docker / Fly.io) needs this one, not CHROME_PATH.
# CHROME_WS_ENDPOINT=ws://your-host:9222/devtools/browser/<id>

# ── Hosted MCP server (npm run mcp:http) ────────────────────────────────────
# Only needed if you run the server over HTTP (to reach it remotely, from the
# Telegram bot or `claude mcp add --transport http`). The stdio server (npm run
# mcp) and the CLI scripts don't use these.

# Shared secret every HTTP client must send as `Authorization: Bearer <token>`.
# The HTTP server refuses to start without it. Generate a strong random value,
# e.g.  openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# Port the HTTP server listens on (default 3000).
# MCP_HTTP_PORT=3000

# In a container, point these at the mounted volume holding your personal files.
# Locally you can leave them unset (they default to the project root).
# SHUFERSAL_DICT_PATH=/data/product-dictionary.json
# SHUFERSAL_ORDER_STATS_PATH=/data/order-stats.json

# ── Telegram bot (npm run bot) ──────────────────────────────────────────────
# Only needed to run the Telegram front-end.

# Bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=123456:your-bot-token

# Comma-separated Telegram chat/user IDs allowed to use the bot. Everyone else
# is ignored. Find yours by messaging @userinfobot. The bot refuses to start if
# this is empty (an open bot could drive your cart).
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Free Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Where the bot reaches the MCP server. Locally, the default is fine once the
# HTTP server is running; in docker-compose it's set to http://mcp:3000/mcp.
# MCP_SERVER_URL=http://localhost:3000/mcp
# BOT_HISTORY_TURNS=10
