{
  "name": "shufersal-shop",
  "version": "1.1.0",
  "description": "A self-contained Claude skill for natural-language grocery shopping on Shufersal.",
  "private": true,
  "scripts": {
    "add": "tsx scripts/add-to-cart.ts",
    "remove": "tsx scripts/remove-from-cart.ts",
    "view": "tsx scripts/view-cart.ts",
    "build-dictionary": "tsx scripts/build-dictionary.ts",
    "suggest": "tsx scripts/suggest.ts",
    "search": "tsx scripts/search.ts",
    "sample-stats": "tsx scripts/sample-stats.ts",
    "check-browser": "tsx scripts/check-browser.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/lib/*.test.ts scripts/*.test.ts"
  },
  "dependencies": {
    "puppeteer-core": "^24.2.1",
    "shufersal-automation": "file:vendor/shufersal-automation"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "dotenv": "^16.4.7",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  }
}
